NODE_ENV=development
PORT=3333

# Banco de dados (Supabase)
# DATABASE_URL → pooled via pgBouncer (porta 6543) — usado pelo app em runtime
# DIRECT_URL   → conexão direta (porta 5432)        — usado pelo Prisma para migrations/generate
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="seu_secret_aqui"
JWT_EXPIRES_IN="7d"

# Email SMTP (Brevo / Sendinblue — smtp-relay.brevo.com:587)
EMAIL_FROM="noreply@seudominio.com"
EMAIL_SMTP_LOGIN="seu_login_brevo@example.com"
EMAIL_SMTP_KEY="sua_chave_smtp_brevo"

# Configurações da aplicação
APP_NAME="Legacy"
APP_URL="http://localhost:3333"
FRONTEND_URL="exp://192.168.x.x:8081"
